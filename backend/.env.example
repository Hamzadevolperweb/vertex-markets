NODE_ENV=development
PORT=3000

# Mongo (optional / legacy — primary DB is Supabase Postgres)
MONGODB_URI=mongodb://mongo:27017/vertex_markets

# ── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_STORAGE_BUCKET=uploads
# SUPABASE_JWT_SECRET=replace_me

# Transaction-mode pooler (IPv4) — runtime queries
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session-mode pooler — migrations
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional S3 protocol for Storage
# SUPABASE_S3_ENDPOINT=https://YOUR_PROJECT.storage.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=ca-central-1
# SUPABASE_S3_ACCESS_KEY_ID=replace_me
# SUPABASE_S3_SECRET_ACCESS_KEY=replace_me

# CORS
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=vertex-markets
JWT_AUDIENCE=vertex-clients

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=

# Cloudinary (optional legacy)
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
CLOUDINARY_FOLDER=vertex-markets

# Email (Resend) — https://resend.com
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Vertex Markets <onboarding@resend.dev>"

# Market Data (Finnhub-compatible) — key stays server-side only
MARKET_DATA_PROVIDER=finnhub
MARKET_DATA_BASE_URL=https://finnhub.io/api/v1
MARKET_DATA_API_KEY=replace_me

# KYC (Sumsub-compatible)
KYC_PUBLIC_ID=replace_me_public_id
KYC_SECRET_KEY=replace_me_secret_key
KYC_API_BASE_URL=https://api.sumsub.com
KYC_LEVEL_NAME=basic-kyc-level
KYC_TOKEN_TTL_SECONDS=600

# App URLs
APP_PUBLIC_URL=http://localhost:3000
APP_FRONTEND_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=900

# Swagger
SWAGGER_TITLE=Vertex Markets API
SWAGGER_VERSION=1.0.0

# Production SSL (Let's Encrypt)
# DOMAIN=your-domain.com
# CERTBOT_EMAIL=admin@your-domain.com
