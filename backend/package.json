{
  "name": "vertex-markets-backend",
  "version": "1.0.0",
  "description": "Production-ready backend for a modern Forex/Trading company website.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 nodemon -r dotenv/config src/server.js",
    "start": "node -r dotenv/config src/server.js",
    "lint": "node -e \"console.log('lint not configured')\"",
    "seed": "NODE_TLS_REJECT_UNAUTHORIZED=0 node -r dotenv/config src/seeders/seed.js",
    "migrate": "NODE_TLS_REJECT_UNAUTHORIZED=0 node -r dotenv/config src/scripts/migrate-supabase.js",
    "swagger": "node src/scripts/generate-swagger.js"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.109.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "7.6.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.7",
    "nodemailer": "^6.9.14",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^2.4.1",
    "resend": "^6.18.0",
    "slugify": "^1.6.6",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.12.0",
    "winston": "^3.14.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^7.9.1"
  }
}
