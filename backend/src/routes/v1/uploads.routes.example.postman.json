            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "/path/to/cms-image.png" }
              ]
            }
          }
        },
        {
          "name": "Upload Platform Image",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/uploads/platform-image",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "uploads", "platform-image"]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "/path/to/platform-image.png" }
              ]
            }
          }
        },
        {
          "name": "Upload Market Icon",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/uploads/market-icon",
