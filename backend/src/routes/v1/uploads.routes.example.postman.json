{
  "info": {
    "name": "Vertex Markets - Uploads Module",
    "description": "Complete Uploads module endpoints for Vertex Markets API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Get File By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/uploads/{{upload_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "uploads", "{{upload_id}}"]
            }
          }
        },
        {
          "name": "Serve File By fileName",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/uploads/file/{{file_name}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "uploads", "file", "{{file_name}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin Uploads",
      "item": [
        {
          "name": "Upload Avatar",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/uploads/avatar",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "uploads", "avatar"]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "/path/to/avatar.jpg" }
              ]
            }
          }
        },
        {
          "name": "Upload Blog Image",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/uploads/blog-image",
