            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "/path/to/blog-image.jpg" }
              ]
            }
          }
        },
        {
          "name": "Upload CMS Image",
          "request": {
            "method": "POST",
