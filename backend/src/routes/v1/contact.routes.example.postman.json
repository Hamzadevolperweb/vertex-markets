          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/api/v1/contact",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "v1", "contact"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Jane Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"phone\": \"+15551234567\",\n  \"country\": \"United States\",\n  \"subject\": \"Account opening question\",\n  \"message\": \"I would like to know the documents required to open a trading account.\",\n  \"department\": \"Support\"\n}"
        }
      }
    },
