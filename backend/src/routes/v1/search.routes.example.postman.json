    {
      "name": "Pagination Example",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search/blog?q=&status=published&page=2&limit=5&sortBy=publishedAt&sortOrder=desc",
          "host": ["{{baseUrl}}"],
          "path": ["search", "blog"],
          "query": [
            { "key": "q", "value": "" },
            { "key": "status", "value": "published" },
            { "key": "page", "value": "2" },
            { "key": "limit", "value": "5" },
            { "key": "sortBy", "value": "publishedAt" },
            { "key": "sortOrder", "value": "desc" }
          ]
        },
        "description": "Example demonstrating pagination: page 2 with 5 items per page."
      }
    },
    {
      "name": "Date Range Example",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search/blog?q=&status=published&dateFrom=2024-06-01T00:00:00.000Z&dateTo=2024-12-31T23:59:59.999Z&page=1&limit=20&sortBy=publishedAt&sortOrder=desc",
          "host": ["{{baseUrl}}"],
          "path": ["search", "blog"],
          "query": [
            { "key": "q", "value": "" },
            { "key": "status", "value": "published" },
            { "key": "dateFrom", "value": "2024-06-01T00:00:00.000Z" },
            { "key": "dateTo", "value": "2024-12-31T23:59:59.999Z" },
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "20" },
            { "key": "sortBy", "value": "publishedAt" },
            { "key": "sortOrder", "value": "desc" }
          ]
        },
        "description": "Example demonstrating date range filtering."
