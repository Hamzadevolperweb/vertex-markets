      }
    },
    {
      "name": "Search Partners (Admin)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search/partners?q=&partnerType=Affiliate%20Partner&status=approved&page=1&limit=20&sortBy=createdAt&sortOrder=desc",
          "host": ["{{baseUrl}}"],
