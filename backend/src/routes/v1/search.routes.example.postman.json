    {
      "name": "Search Careers",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/search/careers?q=developer&status=open&department=engineering&page=1&limit=20&sortBy=createdAt&sortOrder=desc",
          "host": ["{{baseUrl}}"],
          "path": ["search", "careers"],
